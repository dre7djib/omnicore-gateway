    {
      "name": "06 — Orders",
      "item": [
        {
          "name": "POST /api/orders (create — pending)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.test(\"Status is pending\", () => pm.expect(body.status).to.eql('pending'));",
            "pm.test(\"Has totalAmount\", () => pm.expect(parseFloat(body.totalAmount)).to.be.above(0));",
            "pm.collectionVariables.set('orderId', body.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{principalToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"countryId\":\"{{tenantCountryId}}\",\"items\":[{\"countryProductId\":\"{{cpId}}\",\"quantity\":2}],\"shippingAddress\":{\"street\":\"1 Test Lane\",\"city\":\"Paris\",\"postalCode\":\"75001\"},\"notes\":\"Newman integration test\"}" },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api","orders"] }
          }
        },
        {
          "name": "GET /api/orders",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
            "pm.test(\"Returns array\", () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{principalToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api","orders"] }
          }
        },
        {
          "name": "GET /api/orders?status=pending",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
            "const orders = pm.response.json();",
            "pm.test(\"All pending\", () => orders.forEach(o => pm.expect(o.status).to.eql('pending')));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{principalToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders?status=pending", "host": ["{{baseUrl}}"], "path": ["api","orders"], "query": [{ "key": "status", "value": "pending" }] }
          }
        },
        {
          "name": "GET /api/orders/:id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
            "pm.test(\"Correct order\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId')));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{principalToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api","orders","{{orderId}}"] }
          }
        },
        {
          "name": "PATCH /api/orders/:id/status → confirmed",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test(\"Status confirmed\", () => pm.expect(body.status).to.eql('confirmed'));",
            "pm.test(\"confirmedAt set\", () => pm.expect(body.confirmedAt).to.not.be.null);"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{principalToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\":\"confirmed\"}" },
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}/status", "host": ["{{baseUrl}}"], "path": ["api","orders","{{orderId}}","status"] }
          }
        },
        {
          "name": "PATCH /api/orders/:id/status → shipped",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test(\"Status shipped\", () => pm.expect(body.status).to.eql('shipped'));",
            "pm.test(\"trackingNumber set\", () => pm.expect(body.trackingNumber).to.eql('NM-TRACK-001'));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{principalToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\":\"shipped\",\"trackingNumber\":\"NM-TRACK-001\",\"shippingProvider\":\"DHL\",\"estimatedDelivery\":\"2026-04-01T00:00:00Z\"}" },

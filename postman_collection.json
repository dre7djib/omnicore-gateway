{
  "info": {
    "name": "Omnicore Gateway — Full Integration Tests",
    "description": "End-to-end collection for the API Gateway (port 3010). Covers auth, RBAC, countries, products, country-products, orders, and payments.\n\nRun order matters: the collection is designed to execute top-to-bottom. Each folder saves IDs into collection variables used by later requests.\n\n**Newman CLI:**\n```\nnewman run postman_collection.json --delay-request 100\n```\n\n**Test accounts (pre-seeded):**\n- Principal: admin@omnicore.dev / Admin@1234\n- Tenant:    tenant@omnicore.dev / Tenant@1234\n- User:      regular@omnicore.dev / Regular@123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",          "value": "http://localhost:3010", "type": "string" },
    { "key": "principalToken",   "value": "", "type": "string" },
    { "key": "tenantToken",      "value": "", "type": "string" },
    { "key": "userToken",        "value": "", "type": "string" },
    { "key": "principalId",      "value": "", "type": "string" },
    { "key": "tenantCountryId",  "value": "", "type": "string" },
    { "key": "countryId",        "value": "", "type": "string" },
    { "key": "testCountryCode",  "value": "", "type": "string" },
    { "key": "testCountryName",  "value": "", "type": "string" },
    { "key": "productId",        "value": "", "type": "string" },
    { "key": "cpId",             "value": "", "type": "string" },
    { "key": "orderId",          "value": "", "type": "string" },
    { "key": "cancelOrderId",    "value": "", "type": "string" },
    { "key": "paymentOrderId",   "value": "", "type": "string" },
    { "key": "paymentId",        "value": "", "type": "string" }
  ],
  "item": [

    {
      "name": "01 — Auth",
      "item": [
        {
          "name": "Login as Principal",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test(\"Has accessToken\", () => pm.expect(body.accessToken).to.be.a('string'));",
            "pm.collectionVariables.set('principalToken', body.accessToken);",
            "const payload = JSON.parse(atob(body.accessToken.split('.')[1]));",
            "pm.collectionVariables.set('principalId', payload.sub);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"admin@omnicore.dev\",\"password\":\"Admin@1234\"}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
          }
        },
        {
          "name": "Login as Tenant",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test(\"Has accessToken\", () => pm.expect(body.accessToken).to.be.a('string'));",
            "pm.collectionVariables.set('tenantToken', body.accessToken);",
            "const payload = JSON.parse(atob(body.accessToken.split('.')[1]));",
            "pm.collectionVariables.set('tenantCountryId', payload.countryId);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"tenant@omnicore.dev\",\"password\":\"Tenant@1234\"}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
          }
        },
        {
          "name": "Login as User",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('userToken', body.accessToken);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"regular@omnicore.dev\",\"password\":\"Regular@123\"}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
          }
        },
        {
          "name": "Bad credentials (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"admin@omnicore.dev\",\"password\":\"wrong\"}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
          }
        }
      ]
    },

    {
      "name": "02 — Health & RBAC Guards",
      "item": [
        {
          "name": "GET /health (public)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
            "pm.test(\"Service name\", () => pm.expect(pm.response.json().service).to.eql('omnicore-gateway'));"
          ]}}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "No token → 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api","products"] }
          }
        },
        {
          "name": "User tries to POST country → 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 403\", () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"Hack\",\"countryCode\":\"HK\"}" },
            "url": { "raw": "{{baseUrl}}/api/countries", "host": ["{{baseUrl}}"], "path": ["api","countries"] }
          }
        },
        {
          "name": "Tenant tries to POST country → 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 403\", () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tenantToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"Hack\",\"countryCode\":\"HK\"}" },
            "url": { "raw": "{{baseUrl}}/api/countries", "host": ["{{baseUrl}}"], "path": ["api","countries"] }
          }
        }
      ]
    },

    {
      "name": "03 — Countries",
      "item": [
        {
          "name": "GET /api/countries (Principal)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
            "pm.test(\"Returns array\", () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{principalToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/countries", "host": ["{{baseUrl}}"], "path": ["api","countries"] }
          }
        },
        {
          "name": "GET /api/countries (User)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/countries", "host": ["{{baseUrl}}"], "path": ["api","countries"] }
          }
        },
        {
          "name": "POST /api/countries (Principal)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const suffix = Math.random().toString(36).substring(2, 4).toUpperCase();",
              "pm.collectionVariables.set('testCountryCode', 'T' + suffix);",
              "pm.collectionVariables.set('testCountryName', 'Newman Land ' + suffix);"
            ]}},
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"Has id\", () => pm.expect(body.id).to.be.a('string'));",
              "pm.collectionVariables.set('countryId', body.id);"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{principalToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"{{testCountryName}}\",\"countryCode\":\"{{testCountryCode}}\",\"currency\":\"EUR\"}" },
            "url": { "raw": "{{baseUrl}}/api/countries", "host": ["{{baseUrl}}"], "path": ["api","countries"] }
          }
        },
        {
          "name": "GET /api/countries/:id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
            "pm.test(\"Correct country\", () => pm.expect(pm.response.json().countryCode).to.eql(pm.collectionVariables.get('testCountryCode')));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{principalToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/countries/{{countryId}}", "host": ["{{baseUrl}}"], "path": ["api","countries","{{countryId}}"] }
          }
        },
        {
          "name": "PUT /api/countries/:id (Principal)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
            "pm.test(\"Name updated\", () => pm.expect(pm.response.json().name).to.include('Updated'));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{principalToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"{{testCountryName}} Updated\",\"countryCode\":\"{{testCountryCode}}\",\"currency\":\"EUR\"}" },
            "url": { "raw": "{{baseUrl}}/api/countries/{{countryId}}", "host": ["{{baseUrl}}"], "path": ["api","countries","{{countryId}}"] }
          }
        }
      ]
    },

